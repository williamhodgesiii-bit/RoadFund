# Everything is optional. With nothing set, the app runs in "browser mode":
# each road is saved in the browser that created it.

# Cloud storage (shared neighbor links across devices).
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# AI features: invoice and deed reading, message rewriting, quote comparison,
# "ask the agreement", damage photos, meeting minutes.
ANTHROPIC_API_KEY=

# Optional: canonical URL for metadata. Vercel's production URL is used if unset.
NEXT_PUBLIC_SITE_URL=
