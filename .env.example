# Everything is optional. With nothing set, the app runs in "browser mode":
# each road is saved in the browser that created it, and payments are simulated.

# ---- Cloud storage (neighbor links that work on any phone) ----
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Real payments through Stripe Connect (needs cloud storage) ----
# sk_test_... moves no money; sk_live_... does. Turn on Connect in the Stripe
# dashboard (Express accounts) before using it.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://YOUR-SITE/api/stripe/webhook, listening to events on
# your account AND connected accounts: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# account.updated, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# ---- Email through Resend ----
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Road Fund <notices@yourdomain.com>
EMAIL_FROM=

# ---- Texts through Twilio (needs cloud storage) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a number or a messaging service. US texting needs 10DLC registration.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Set the number's "A message comes in" webhook to https://YOUR-SITE/api/sms/inbound

# ---- Daily reminders, snow alerts and letter nudges ----
# Vercel Cron calls /api/cron/daily (see vercel.json) with this secret.
CRON_SECRET=

# ---- AI features ----
# Invoice and deed reading, message rewriting, quote comparison,
# "ask the agreement", damage photos, meeting minutes.
ANTHROPIC_API_KEY=

# ---- Your details ----
# The public URL. Used in emails, the Stripe webhook origin and Twilio signature checks.
NEXT_PUBLIC_SITE_URL=
# Where agreement-package orders go, and the address shown on the help page.
SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
